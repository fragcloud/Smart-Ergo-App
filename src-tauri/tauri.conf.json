{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Ergo",
  "version": "0.3.1",
  "identifier": "id.pens.smartergo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Smart Ergo",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      },
      {
        "label": "settings",
        "title": "Pengaturan Smart Ergo",
        "url": "settings.html",
        "width": 520,
        "height": 620,
        "minWidth": 480,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}