{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Ergo",
  "version": "0.1.0",
  "identifier": "id.pens.smartergo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Smart Ergo",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "webviewInstallMode": {
          "type": "downloadBootstrapper"
        }
      }
    }
  }
}